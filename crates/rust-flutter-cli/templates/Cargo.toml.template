[package]
name = "{{name}}"
version = "0.1.0"
edition = "2024"

[workspace]

[lib]
crate-type = ["cdylib", "rlib"]

[dependencies]
rust-flutter = { {{framework}} }

[build-dependencies]
rust-flutter-assets = { {{asset_framework}}, features = ["build"] }

[patch.crates-io]
wgpu-hal = { {{patched_hal}} }

[package.metadata.android]
package = "dev.rustflutter.{{android_name}}"
apk_name = "{{name}}"
build_targets = ["aarch64-linux-android"]

[package.metadata.android.sdk]
min_sdk_version = 24
target_sdk_version = 35

[profile.dev]
debug = 0
incremental = false

[package.metadata.android.application.activity]
config_changes = "orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|density|fontScale|layoutDirection|locale|uiMode"
